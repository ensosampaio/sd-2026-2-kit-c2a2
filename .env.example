# Deixe LLM_API_KEY vazia para usar o modo simulado (offline).
# NUNCA escreva a chave no codigo nem faca commit do arquivo .env.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini

# Resiliencia da chamada ao LLM (valores padrao)
LLM_TIMEOUT=20
LLM_TENTATIVAS=3
LLM_BACKOFF_SEGUNDOS=0.5
CB_LIMITE_FALHAS=5
CB_ESPERA_SEGUNDOS=20

# Execucao local (sem Docker). No docker-compose estes valores sao sobrescritos.
URL_INGESTAO=http://localhost:8001
URL_RECUPERACAO=http://localhost:8002
REDIS_URL=redis://localhost:6379/0
FILA_INGESTAO=rag:ingestao:pendentes
FILA_INGESTAO_PROCESSANDO=rag:ingestao:processando
